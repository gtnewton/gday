#!/usr/bin/env bash
# 20-snapraid.sh.example — g'day status plugin: SnapRAID sync age.
#
# To activate: copy to /etc/gday/status.d/20-snapraid.sh, make executable,
# and set SNAPRAID_CONF below if your config is not in the default location.

set -uo pipefail

SNAPRAID_CONF=${SNAPRAID_CONF:-/etc/snapraid.conf}
SNAPRAID_LOG=${SNAPRAID_LOG:-/var/log/snapraid.log}

row() { printf '   %-12s %s\n' "$1" "$2"; }

command -v snapraid >/dev/null 2>&1 || exit 0
[[ -r $SNAPRAID_LOG ]]             || exit 0

# Find the most recent "Completed" line in the log.
last=$(grep -i 'completed' "$SNAPRAID_LOG" 2>/dev/null | tail -1) || exit 0
[[ -n $last ]] || exit 0

# SnapRAID log lines begin with a timestamp like "2026-06-28 03:00:01".
ts=$(printf '%s' "$last" | grep -oP '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}') || exit 0
[[ -n $ts ]] || exit 0

epoch=$(date -d "$ts" +%s 2>/dev/null) || exit 0
now=$(date +%s)
age_days=$(( (now - epoch) / 86400 ))

if (( age_days == 0 )); then
  row 'SnapRAID' 'synced today'
elif (( age_days == 1 )); then
  row 'SnapRAID' 'synced yesterday'
else
  row 'SnapRAID' "synced ${age_days}d ago"
fi
