#!/usr/bin/env bash
# 20-snapraid.sh.example — g'day status plugin: SnapRAID status.
#
# Designed for snapraid-aio-script log format:
#   [YYYY-MM-DD HH:MM:SS] snapraid-aio-script.sh: INFO: 'SnapRAID SYNC finished'
#
# To activate: copy to /etc/gday/status.d/20-snapraid.sh, make executable.
# Set SNAPRAID_LOG below if your log is not at the default location.

set -uo pipefail

SNAPRAID_LOG=${SNAPRAID_LOG:-/var/log/snapraid.log}

row() { printf '       %-12s %s\n' "$1" "$2"; }

[[ -r $SNAPRAID_LOG ]] || exit 0

_age_str() {
  local ts=$1 epoch now age_days
  epoch=$(date -d "$ts" +%s 2>/dev/null) || return 1
  now=$(date +%s)
  age_days=$(( (now - epoch) / 86400 ))
  if (( age_days == 0 )); then printf 'today'
  elif (( age_days == 1 )); then printf 'yesterday'
  else printf '%dd ago' "$age_days"
  fi
}

_last_ts() {
  local pattern=$1 line ts
  line=$(grep -i "$pattern" "$SNAPRAID_LOG" 2>/dev/null | tail -1) || return 1
  [[ -n $line ]] || return 1
  # Timestamp format: [YYYY-MM-DD HH:MM:SS]
  ts=$(printf '%s' "$line" | grep -oP '(?<=\[)\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}(?=\])') || return 1
  [[ -n $ts ]] || return 1
  printf '%s' "$ts"
}

# Show last SYNC if it ran; otherwise last DIFF.
if ts=$(_last_ts 'SnapRAID SYNC finished'); then
  age=$(_age_str "$ts") || exit 0
  row 'SnapRAID' "synced ${age}"
elif ts=$(_last_ts 'SnapRAID DIFF finished'); then
  age=$(_age_str "$ts") || exit 0
  row 'SnapRAID' "diff ${age} (sync not run)"
fi
